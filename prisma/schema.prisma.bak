generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ActionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  EN_RETARD
}

enum DocumentStatus {
  BROUILLON
  VALIDE
  ARCHIVE
}

enum OperationType {
  RECETTE
  DEPENSE
  ENGAGEMENT
  PAIEMENT
}

enum AssetStatus {
  ACTIF
  EN_MAINTENANCE
  HORS_SERVICE
  REFORME
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  agent      Agent?
  auditLogs  AuditLog[]
  documents  Document[] @relation("DocumentAuthor")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  agents Agent[]
  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id             String    @id @default(cuid())
  matricule      String    @unique
  firstName      String
  lastName       String
  position       String?
  contractType   String?
  phone          String?
  email          String?
  hireDate       DateTime?
  serviceId      String?
  service        Service?  @relation(fields: [serviceId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Training {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  category    String?
  level       String?
  duration    String?
  description String?
  active      Boolean  @default(true)

  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Learner {
  id              String       @id @default(cuid())
  matricule       String       @unique
  firstName       String
  lastName        String
  birthDate       DateTime?
  integrationYear Int?
  phone           String?
  email           String?

  enrollments     Enrollment[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Enrollment {
  id            String    @id @default(cuid())
  learnerId     String
  trainingId    String
  startDate     DateTime?
  endDate       DateTime?
  academicYear  String    @default("NON_RENSEIGNEE")
  level         String?
  status        String?

  learner       Learner   @relation(fields: [learnerId], references: [id])
  training      Training  @relation(fields: [trainingId], references: [id])

  @@unique([learnerId, trainingId, academicYear])
}

model Budget {
  id          String   @id @default(cuid())
  year        Int
  title       String
  amount      Decimal  @db.Decimal(15, 2)
  description String?

  lines BudgetLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetLine {
  id          String   @id @default(cuid())
  budgetId    String
  code        String
  label       String
  allocated   Decimal  @db.Decimal(15, 2)
  committed   Decimal  @default(0) @db.Decimal(15, 2)
  spent       Decimal  @default(0) @db.Decimal(15, 2)

  budget Budget @relation(fields: [budgetId], references: [id])
  operations FinancialOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  identifier  String?
  phone       String?
  email       String?
  address     String?

  operations FinancialOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinancialOperation {
  id            String        @id @default(cuid())
  reference     String        @unique
  type          OperationType
  date          DateTime
  description   String
  amount        Decimal       @db.Decimal(15, 2)
  budgetLineId  String?
  supplierId    String?

  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id])
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  assets Asset[]
}

model Asset {
  id             String      @id @default(cuid())
  inventoryCode  String      @unique
  name           String
  description    String?
  acquisitionDate DateTime?
  acquisitionValue Decimal?  @db.Decimal(15, 2)
  location       String?
  status         AssetStatus @default(ACTIF)

  categoryId String?
  category   AssetCategory? @relation(fields: [categoryId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  maintenances Maintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maintenance {
  id          String   @id @default(cuid())
  assetId     String
  date        DateTime
  description String
  cost        Decimal? @db.Decimal(15, 2)
  provider    String?
  status      String?

  asset Asset @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id          String         @id @default(cuid())
  title       String
  fileName    String
  storageKey  String
  mimeType    String?
  size        Int?
  status      DocumentStatus @default(BROUILLON)

  authorId String
  author   User   @relation("DocumentAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)

  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model PSDAxis {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  purpose   String

  objectives PSDObjective[]
  actions    PSDAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PSDObjective {
  id       String   @id @default(cuid())
  axisId   String
  title    String
  axis     PSDAxis  @relation(fields: [axisId], references: [id])
  actions  PSDAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PSDAction {
  id          String       @id @default(cuid())
  objectiveId String?
  axisId      String
  title       String
  indicator   String?
  baseline    String?
  target2031  String?
  responsible String?
  startYear   Int
  endYear     Int
  budget      Decimal?     @db.Decimal(15, 2)
  status      ActionStatus @default(PLANIFIEE)
  progress    Int          @default(0)

  axis      PSDAxis       @relation(fields: [axisId], references: [id])
  objective PSDObjective? @relation(fields: [objectiveId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
